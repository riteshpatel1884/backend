<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 480px; margin: 2rem auto; padding: 0 1rem; }
    .card { border: 1px solid #ddd; border-radius: 10px; padding: 2rem; box-shadow: 0 2px 10px rgba(0,0,0,.05); }
    label, input, button { display: block; width: 100%; }
    input { margin-bottom: 1rem; padding: .75rem; border: 1px solid #ccc; border-radius: 6px; }
    button { padding: .85rem; background: #2563eb; color: white; border: none; border-radius: 6px; cursor: pointer; }
    .error { color: #b91c1c; margin-bottom: 1rem; }
    .footer { margin-top: 1.25rem; font-size: .95rem; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Create Account</h1>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form action="/register" method="POST">
      <label for="username">Username</label>
      <input id="username" type="text" name="username" required />
      <label for="email">Email</label>
      <input id="email" type="email" name="email" required />
      <label for="password">Password</label>
      <input id="password" type="password" name="password" required />
      <button type="submit">Register</button>
    </form>
    <p class="footer">Already have an account? <a href="/login">Sign in</a></p>
  </div>
</body>
</html>